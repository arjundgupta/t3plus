{
  "name": "t3plus",
  "version": "0.23.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "description": "t3+: a glow, glass composer, usage widgets, bots, profiles, a Status view and a screenshot mode for the T3 Code desktop app",
  "type": "module",
  "engines": {
    "node": ">=22.2"
  },
  "scripts": {
